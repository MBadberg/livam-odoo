<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_livam" model="ir.ui.view">
        <field name="name">res.config.settings.livam.connector</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="LiVaM" string="LiVaM" name="livam">
                    <block title="LiVaM" name="livam_connection_setting_container">
                        <setting id="livam_base_url_setting"
                                 string="Verbindung"
                                 help="Verbindung zur LiVaM-Lizenz- und Provisioning-API.">
                            <div class="content-group">
                                <div class="mt16 row">
                                    <label for="livam_base_url"
                                           class="col-3 col-lg-3 o_light_label"/>
                                    <field name="livam_base_url" class="col-6"
                                           placeholder="https://lus.lingavena.de"/>
                                </div>
                                <div class="mt16 row">
                                    <label for="livam_operator_token"
                                           class="col-3 col-lg-3 o_light_label"/>
                                    <field name="livam_operator_token"
                                           class="col-6" password="1"/>
                                </div>
                                <div class="mt16 row">
                                    <label for="livam_webhook_secret"
                                           class="col-3 col-lg-3 o_light_label"/>
                                    <field name="livam_webhook_secret"
                                           class="col-6" password="1"/>
                                </div>
                                <div class="mt16 row">
                                    <label for="livam_timeout"
                                           class="col-3 col-lg-3 o_light_label"/>
                                    <field name="livam_timeout" class="col-2"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
