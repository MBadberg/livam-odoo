<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_livam_installation_tree" model="ir.ui.view">
        <field name="name">livam.installation.tree</field>
        <field name="model">livam.installation</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="name"/>
                <field name="deployment_mode"/>
                <field name="online" widget="boolean_toggle"/>
                <field name="license_id"/>
                <field name="software_version"/>
                <field name="server_url"/>
                <field name="last_seen_at"/>
            </list>
        </field>
    </record>

    <record id="view_livam_installation_form" model="ir.ui.view">
        <field name="name">livam.installation.form</field>
        <field name="model">livam.installation</field>
        <field name="arch" type="xml">
            <form string="LiVaM-Installation">
                <header>
                    <button name="action_revoke_certificate" type="object"
                            string="Zertifikat widerrufen"
                            confirm="Das Installationszertifikat in LiVaM widerrufen?"/>
                    <button name="action_sync_one" type="object" string="Aktualisieren"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="livam_id"/>
                            <field name="installation_uuid"/>
                            <field name="instance_key"/>
                            <field name="deployment_mode"/>
                            <field name="online"/>
                        </group>
                        <group>
                            <field name="license_id"/>
                            <field name="software_version"/>
                            <field name="server_url"/>
                            <field name="first_seen_at"/>
                            <field name="last_seen_at"/>
                            <field name="last_synced_at"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_livam_installation" model="ir.actions.act_window">
        <field name="name">Installationen</field>
        <field name="res_model">livam.installation</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
