<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_livam" model="ir.ui.view">
        <field name="name">sale.order.form.livam</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="LiVaM" name="livam">
                    <group>
                        <group>
                            <field name="livam_tenant_slug"/>
                            <field name="livam_domain"/>
                            <field name="livam_billing_cycle"/>
                            <field name="livam_features"/>
                        </group>
                        <group>
                            <field name="livam_license_id"/>
                            <field name="livam_tenant_url" widget="url"/>
                            <field name="livam_provisioning_status"/>
                            <field name="livam_marked_paid"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
